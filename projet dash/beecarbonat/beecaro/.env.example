# ==============================================================================
# BeeCarbonat (CAFM & ESG Platform) — Environment Configuration Template
# ==============================================================================

# Server Configuration
PORT=3000
NODE_ENV=development

# Database (PostgreSQL Neon Serverless or Local)
# If left blank, BeeCarbonat automatically falls back to high-fidelity In-Memory simulator
DATABASE_URL=postgresql://postgres:password@localhost:5432/beecarbonat
POSTGRES_URL=
MY_NEON_DB_URL=

# AI Diagnostics & Predictive Engine (Google Gemini)
GEMINI_API_KEY=your_gemini_api_key_here

# PayPal Billing & Enterprise Subscriptions
PAYPAL_CLIENT_ID=BAAd4qjSxz7BLyZM95yOWEO0G7s2OUm_qDWLGEgwpeUEG1NNH6_02kGPlhmr8OK98lbscHbMVIin7NGhdc
PAYPAL_CLIENT_SECRET=your_paypal_secret_here
PAYPAL_APP_NAME=beecarbonat
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_PLAN_ID_PRO=P-PRO-BIZOS
PAYPAL_PLAN_ID_ENTERPRISE=P-ENTERPRISE-BIZOS
PAYPAL_WEBHOOK_ID=

# Authentication & Security
JWT_SECRET=super_secret_jwt_key_change_in_production_min_32_chars
CORS_ORIGIN=*
