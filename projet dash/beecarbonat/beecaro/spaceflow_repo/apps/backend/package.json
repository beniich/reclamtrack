{
  "name": "cafm-backend",
  "version": "2.1.0",
  "description": "API REST pour la plateforme CAFM Pro",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "prisma:generate": "npm run db:generate --workspace=@BeeCarbonat/database",
    "prisma:migrate": "cd ../../packages/database && prisma migrate dev",
    "prisma:deploy": "cd ../../packages/database && prisma migrate deploy",
    "prisma:reset": "cd ../../packages/database && prisma db push --force-reset && node prisma/seed.js",
    "seed": "node ../../packages/database/prisma/seed.js",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:load": "k6 run performance/k6-load-test.js",
    "test:stress": "k6 run performance/k6-stress-test.js",
    "lint": "eslint src/",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1114.0",
    "@aws-sdk/s3-request-presigner": "^3.1114.0",
    "@BeeCarbonat/database": "*",
    "@bull-board/api": "^9.3.2",
    "@bull-board/express": "^9.3.2",
    "@google/generative-ai": "^0.24.1",
    "@sentry/node": "^10.69.0",
    "@sentry/profiling-node": "^10.69.0",
    "@upstash/redis": "^1.38.2",
    "axios": "^1.6.5",
    "bcryptjs": "^2.4.3",
    "bullmq": "^6.1.2",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "csrf-csrf": "^4.0.3",
    "dotenv": "^16.4.0",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.3.2",
    "helmet": "^7.1.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "mqtt": "^5.15.2",
    "multer": "^1.4.5-lts.1",
    "opossum": "^5.0.1",
    "pdfkit": "^0.15.0",
    "pg": "^8.11.3",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "rate-limiter-flexible": "^11.2.0",
    "resend": "^3.2.0",
    "socket.io": "^4.7.0",
    "speakeasy": "^2.0.0",
    "stripe": "^16.0.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "three": "^0.160.0",
    "uuid": "^14.0.2",
    "web-push": "^3.6.6",
    "ws": "^8.21.3",
    "xmlrpc": "^1.3.2",
    "xss": "^1.0.15",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.3",
    "prettier": "^3.2.5",
    "supertest": "^6.3.4"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
